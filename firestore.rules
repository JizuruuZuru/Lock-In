rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return userExists()
        && 'role' in userData()
        && userData().role == 'admin'
        && (!('disabled' in userData()) || userData().disabled == false);
    }

    function newRole() {
      return 'role' in request.resource.data
        ? request.resource.data.role
        : 'student';
    }

    function oldRole() {
      return 'role' in resource.data ? resource.data.role : 'student';
    }

    function newDisabled() {
      return 'disabled' in request.resource.data
        ? request.resource.data.disabled
        : false;
    }

    function oldDisabled() {
      return 'disabled' in resource.data ? resource.data.disabled : false;
    }

    function keepsOwnPrivileges() {
      return newRole() == oldRole() && newDisabled() == oldDisabled();
    }

    function ownsDoc() {
      return isSignedIn()
        && 'uid' in resource.data
        && resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      allow create: if isAdmin()
        || (isSelf(uid) && newRole() == 'student' && newDisabled() == false);

      allow update: if isAdmin() || (isSelf(uid) && keepsOwnPrivileges());

      allow delete: if false;

      match /game_logs/{logId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if isSelf(uid);
      }

      match /leave_attempts/{attemptId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if isSelf(uid);
      }

      // Written by the profile screen's "Clear data" button. Rules do not
      // cascade to subcollections, so without this block the write is denied
      // and the handler throws before the player sees any confirmation.
      match /data_clear_events/{eventId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if isSelf(uid);
      }
    }

    match /quiz_questions/{questionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /leaderboard_entries/{entryId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && entryId.split('_')[0] == request.auth.uid;
    }

    match /exam_attempts/{attemptId} {
      allow read: if isAdmin() || ownsDoc();
      allow create: if isSignedIn()
        && 'uid' in request.resource.data
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /exam_sessions/{sessionId} {
      allow read: if isAdmin() || ownsDoc();
      // A session document carries the player's uid, so the same ownership
      // check exam_attempts uses applies here. Without it any signed-in
      // account could overwrite another player's exam session.
      allow create: if isSignedIn()
        && 'uid' in request.resource.data
        && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() || ownsDoc();
      allow delete: if isAdmin();
    }
  }
}
